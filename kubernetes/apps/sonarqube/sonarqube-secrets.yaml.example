---
# Both keys must hold the same value: postgres initialises its superuser with
# POSTGRES_PASSWORD, and SonarQube authenticates with SONAR_JDBC_PASSWORD.
apiVersion: v1
kind: Secret
metadata:
  name: sonarqube-secret
  namespace: sonarqube-namespace
type: Opaque
stringData:
  POSTGRES_PASSWORD: "YOUR_SONARQUBE_DB_PASSWORD"
  SONAR_JDBC_PASSWORD: "YOUR_SONARQUBE_DB_PASSWORD"
